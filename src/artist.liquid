---
layout: layout.liquid
title: "{{ artist.name }} — OriginGFX"
pagination:
  data: supabase.artists
  size: 1
  alias: artist
permalink: "/artist/{{ artist.slug }}/"
---

<!-- ============================================================
     HERO — AVATAR & IDENTITAS DALAM SATU BLOK HORIZONTAL
     ============================================================ -->
<section class="artist-profile-hero" style="background: linear-gradient(135deg, var(--bg) 0%, var(--surface-2) 100%); padding: 20px 0 40px;">
    <div class="container">
        <a href="#" class="back-link" onclick="history.back(); return false;">← Back</a>

        <div class="profile-hero-content">
            <!-- ===== AVATAR ===== -->
            <div class="profile-hero-avatar" style="background-image: url('{{ artist.avatar }}'); background-size: cover; background-position: center;"></div>

        <!-- ===== IDENTITAS ===== -->
        <div class="profile-hero-info">
            <!-- Nama + Badge Founder di sini -->
            <div class="profile-name-wrapper">
                <h1>{{ artist.name }}</h1>
                {% if artist.badge == "founder" %}
                    <span class="founder-badge">✦ Founder</span>
                {% endif %}
            </div>

            <!-- Role + Badge lainnya -->
            <div class="profile-role-wrapper">
                {% if artist.badge and artist.badge != "founder" %}
                    <span class="artist-badge {{ artist.badge }}">
                        {% case artist.badge %}
                            {% when 'founder' %}👑 Founder
                            {% when 'featured' %}⭐ Featured
                            {% when 'new' %}🌱 New Artist
                            {% when 'verified' %}✔ Verified
                            {% when 'contributor' %}🤝 Contributor
                            {% when 'curator' %}🏛 Curator
                            {% when 'editors-pick' %}🏆 Editor's Pick
                            {% when 'community-favorite' %}❤️ Community Favorite
                        {% endcase %}
                    </span>
                {% endif %}
                <span class="profile-role">{{ artist.role }}</span>
            </div>

            <!-- ===== ROLE DESCRIPTION (Founder, Contributor, Curator) ===== -->
            <div class="role-description-block">
                {% if artist.badge == "founder" %}
                    <div class="role-desc-item">
                        <span class="role-desc-label">✦ Founder of OriginGFX</span>
                        <p class="role-desc-text">OriginGFX dimulai sebagai portfolio pribadi dan kini menjadi rumah bagi artist lain.</p>
                    </div>
                {% elsif artist.badge == "contributor" %}
                    <div class="role-desc-item">
                        <span class="role-desc-label">✦ Contributor to OriginGFX</span>
                        <p class="role-desc-text">Berkontribusi dalam membangun komunitas, proyek, dan ruang kreatif di OriginGFX.</p>
                    </div>
                {% elsif artist.badge == "curator" %}
                    <div class="role-desc-item">
                        <span class="role-desc-label">✦ Curator at OriginGFX</span>
                        <p class="role-desc-text">Membantu memilih dan menyoroti karya yang menjadi bagian dari gallery OriginGFX.</p>
                    </div>
                {% endif %}
            </div>

            <!-- ===== METADATA SINGKAT ===== -->
            <div class="profile-meta">
                {% assign artistArtworks = supabase.artworks | where: "artist_id", artist.id | size %}
                <span><strong>{{ artistArtworks }}</strong> Artworks</span>
                <span class="meta-dot">•</span>
                {% if artist.location %}
                    <span>{{ artist.location }}</span>
                    <span class="meta-dot">•</span>
                {% endif %}
                {% if artist.joined %}
                    <span>Since {{ artist.joined }}</span>
                    <span class="meta-dot">•</span>
                {% endif %}
                {% if artist.badge %}
                    <span class="badge-label">{{ artist.badge | capitalize }}</span>
                {% endif %}
            </div>

                <!-- ===== BADGE COMMISSION STATUS ===== -->
                {% assign hasContact = false %}
                {% if artist.social.instagram or artist.social.discord or artist.social.fiverr %}
                    {% assign hasContact = true %}
                {% endif %}
                <div class="commission-status">
                    {% if hasContact %}
                        <span class="status-badge available">● Available for Commission</span>
                    {% else %}
                        <span class="status-badge closed">○ Commission Closed</span>
                    {% endif %}
                </div>

                <!-- ===== BIO (disingkat + Read More) ===== -->
                {% assign bioLength = artist.bio | size %}
                {% if bioLength > 120 %}
                    <div class="bio-wrapper">
                        <p class="profile-hero-bio truncated" id="bio-short">
                            {{ artist.bio | truncate: 120 }}
                            <span class="bio-dots">…</span>
                        </p>
                        <p class="profile-hero-bio full" id="bio-full" style="display: none;">
                            {{ artist.bio }}
                        </p>
                        <button class="bio-toggle" id="bio-toggle" aria-expanded="false">
                            Read More ↓
                        </button>
                    </div>
                {% else %}
                    <p class="profile-hero-bio">{{ artist.bio }}</p>
                {% endif %}

                <!-- ===== SOCIAL LINKS (dengan icon) ===== -->
                <div class="profile-hero-social">
                    {% if artist.social.instagram %}
                        <a href="{{ artist.social.instagram }}" target="_blank" class="social-link instagram">Instagram</a>
                    {% endif %}
                    {% if artist.social.twitter %}
                        <a href="{{ artist.social.twitter }}" target="_blank" class="social-link twitter">Twitter</a>
                    {% endif %}
                    {% if artist.social.discord %}
                        <a href="{{ artist.social.discord }}" target="_blank" class="social-link discord">Discord</a>
                    {% endif %}
                    {% if artist.social.fiverr %}
                        <a href="{{ artist.social.fiverr }}" target="_blank" class="social-link fiverr">Fiverr</a>
                    {% endif %}
                    {% if artist.social.tiktok %}
                        <a href="{{ artist.social.tiktok }}" target="_blank" class="social-link tiktok">TikTok</a>
                    {% endif %}
                    {% if artist.social.youtube %}
                        <a href="{{ artist.social.youtube }}" target="_blank" class="social-link youtube">YouTube</a>
                    {% endif %}
                    {% if artist.social.website %}
                        <a href="{{ artist.social.website }}" target="_blank" class="social-link website">Website</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     PROFILE OVERVIEW — 4 ANGKA SEBELUM PORTFOLIO
     ============================================================ -->
<section class="section" style="padding-top: 20px; padding-bottom: 20px;">
    <div class="container">
        <div class="profile-overview">
            {% assign totalArtworks = supabase.artworks | where: "artist_id", artist.id | size %}
            {% assign totalServices = artist.services | size %}
            <div class="overview-item">
                <span class="overview-number">{{ totalArtworks }}</span>
                <span class="overview-label">Artworks</span>
            </div>
            <div class="overview-divider"></div>
            <div class="overview-item">
                <span class="overview-number">{{ totalServices }}</span>
                <span class="overview-label">Services</span>
            </div>
            <div class="overview-divider"></div>
            <div class="overview-item">
                <span class="overview-number">{{ artist.joined | default: '2023' }}</span>
                <span class="overview-label">Joined</span>
            </div>
            <div class="overview-divider"></div>
            <div class="overview-item">
                <span class="overview-number">✦</span>
                <span class="overview-label">{{ artist.badge | capitalize | default: 'Artist' }}</span>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     PORTFOLIO — CLIENT-SIDE RENDER (SAMA KAYAK EXPLORE)
     ============================================================ -->
<section class="section" style="padding-top: 20px;">
    <div class="container">
        <div class="portfolio-header">
            <h2 class="section-title">Portfolio</h2>
            <div class="portfolio-controls">
                <select id="sort-select" class="sort-select">
                    <option value="created_at.desc">Latest</option>
                    <option value="created_at.asc">Oldest</option>
                    <option value="views.desc">Most Viewed</option>
                    <option value="featured.desc">Featured</option>
                </select>
            </div>
        </div>

        {% assign artistArtworks = supabase.artworks | where: "artist_id", artist.id %}
        {% assign totalArtworks = artistArtworks | size %}

        {% if totalArtworks == 0 %}
            <p class="no-artwork">Belum ada artwork yang dipublikasikan.</p>
        {% else %}
            <!-- INFORMASI TOTAL -->
            <div class="portfolio-info" id="portfolio-info">
                Showing <span id="showing-count">0</span> of <span id="total-count">{{ totalArtworks }}</span> artworks
            </div>

            <!-- GRID (diisi JavaScript) -->
            <div id="portfolio-grid" class="grid grid-3">
                <!-- Akan diisi oleh JavaScript -->
            </div>

            <!-- ACTION BUTTONS -->
            <div class="portfolio-actions">
                <button class="btn load-more-btn" id="load-more-btn">Load More</button>
                <button class="btn btn-outline" id="view-all-btn">View Full Portfolio →</button>
            </div>
        {% endif %}
    </div>
</section>

<!-- ============================================================
     SERVICES — DENGAN ICON SVG
     ============================================================ -->
<section class="section reveal" style="padding-top: 60px;">
    <div class="container">
        <h2 class="section-title">Services</h2>

        {% if artist.services and artist.services.size > 0 %}
            <div class="services-grid-icons">
                {% for service in artist.services %}
                    <div class="service-item">
                        {% case service %}
                            {% when 'Minecraft Art' %}
                                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                                    <polyline points="2 17 12 22 22 17"/>
                                    <polyline points="2 12 12 17 22 12"/>
                                </svg>
                            {% when 'Thumbnail' %}
                                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                    <line x1="8" y1="21" x2="16" y2="21"/>
                                    <line x1="12" y1="17" x2="12" y2="21"/>
                                </svg>
                            {% when 'Poster' %}
                                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 2h16v20H4z"/>
                                    <line x1="8" y1="6" x2="16" y2="6"/>
                                    <line x1="8" y1="10" x2="16" y2="10"/>
                                    <line x1="8" y1="14" x2="14" y2="14"/>
                                </svg>
                            {% when 'Wallpaper' %}
                                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="2" width="20" height="20" rx="2"/>
                                    <path d="M8.5 10.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                                    <path d="M21 15l-5-5-5 5-3-3-5 5"/>
                                </svg>
                            {% when 'Cinematic' %}
                                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                                    <path d="M8 4v16"/>
                                    <path d="M16 4v16"/>
                                    <path d="M2 9h20"/>
                                    <path d="M2 15h20"/>
                                </svg>
                            {% else %}
                                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <path d="M12 6v6l4 2"/>
                                </svg>
                        {% endcase %}
                        <span class="service-name">{{ service }}</span>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="no-services">Belum ada layanan yang ditawarkan.</p>
        {% endif %}

        <!-- ===== COMMISSION BUTTONS ===== -->
        <div class="commission-buttons">
            <!-- Primary: Instagram atau Discord (prioritas Instagram) -->
            {% if artist.social.instagram %}
                <a href="{{ artist.social.instagram }}" target="_blank" class="btn btn-primary btn-commission">Commission via Instagram</a>
            {% elsif artist.social.discord %}
                <a href="{{ artist.social.discord }}" target="_blank" class="btn btn-primary btn-commission">Commission via Discord</a>
            {% elsif artist.social.fiverr %}
                <a href="{{ artist.social.fiverr }}" target="_blank" class="btn btn-primary btn-commission">Commission via Fiverr</a>
            {% endif %}

            <!-- Secondary: Discord / Fiverr / lainnya (jika tidak sama dengan primary) -->
            <div class="commission-secondary">
                {% if artist.social.instagram and artist.social.discord %}
                    <a href="{{ artist.social.discord }}" target="_blank" class="btn btn-secondary">Discord</a>
                {% endif %}
                {% if artist.social.instagram and artist.social.fiverr %}
                    <a href="{{ artist.social.fiverr }}" target="_blank" class="btn btn-secondary">Fiverr</a>
                {% endif %}
                {% if artist.social.discord and artist.social.fiverr and artist.social.instagram == null %}
                    <a href="{{ artist.social.fiverr }}" target="_blank" class="btn btn-secondary">Fiverr</a>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     SPECIALTIES / TAGS
     ============================================================ -->
{% if artist.specialties and artist.specialties.size > 0 %}
<section class="section reveal" style="padding-top: 40px;">
    <div class="container">
        <h2 class="section-title">Specialties</h2>
        <div class="specialties-list">
            {% for tag in artist.specialties %}
                <span class="specialty-tag">{{ tag }}</span>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<!-- ============================================================
     ABOUT — DENGAN JARAK LEBIH BESAR DARI SERVICES
     ============================================================ -->
<section class="section reveal" style="padding-top: 40px; padding-bottom: 60px;">
    <div class="container">
        <h2 class="section-title">About {{ artist.name }}</h2>
        <div class="about-artist">
            <p>{{ artist.bio }}</p>
            {% if artist.badge == "founder" %}
                <p class="founder-note"><strong>✦ Founder of OriginGFX</strong> — OriginGFX dimulai sebagai portfolio pribadi dan kini menjadi rumah bagi artist lain.</p>
            {% endif %}
            {% if artist.location %}
                <p class="location-note">📍 {{ artist.location }}</p>
            {% endif %}
        </div>
    </div>
</section>

<!-- ============================================================
     SIGNATURE
     ============================================================ -->
<section class="section reveal section-signature">
    <div class="signature-section">
        <div class="signature-quote">
            <span class="quote-mark">✦</span>
            <p>Behind every artwork is a story worth knowing.</p>
        </div>
    </div>
</section>

<!-- ============================================================
     JAVASCRIPT — BIO TOGGLE + PORTFOLIO (CLIENT-SIDE)
     ============================================================ -->
<script>
    (function() {
        // ===== BIO TOGGLE =====
        const toggle = document.getElementById('bio-toggle');
        if (toggle) {
            const short = document.getElementById('bio-short');
            const full = document.getElementById('bio-full');
            toggle.addEventListener('click', function() {
                const expanded = this.getAttribute('aria-expanded') === 'true';
                if (expanded) {
                    short.style.display = 'block';
                    full.style.display = 'none';
                    this.textContent = 'Read More ↓';
                    this.setAttribute('aria-expanded', 'false');
                } else {
                    short.style.display = 'none';
                    full.style.display = 'block';
                    this.textContent = 'Show Less ↑';
                    this.setAttribute('aria-expanded', 'true');
                }
            });
        }

        // ===== PORTFOLIO — CLIENT-SIDE =====
        {% assign artistArtworks = supabase.artworks | where: "artist_id", artist.id %}
        const allArtworks = {{ artistArtworks | json }};
        const grid = document.getElementById('portfolio-grid');
        const loadBtn = document.getElementById('load-more-btn');
        const showingSpan = document.getElementById('showing-count');
        const totalSpan = document.getElementById('total-count');
        const sortSelect = document.getElementById('sort-select');
        const viewAllBtn = document.getElementById('view-all-btn');

        if (!grid) return;

        let filteredData = [];
        let currentPage = 1;
        const perPage = 6;

        if (totalSpan) totalSpan.textContent = allArtworks.length;

        // ===== SORT =====
        function sortArtworks(items, sortKey) {
            const [field, direction] = sortKey.split('.');
            const sorted = [...items];
            sorted.sort((a, b) => {
                let valA = a[field] || 0;
                let valB = b[field] || 0;
                if (field === 'created_at') {
                    valA = new Date(valA);
                    valB = new Date(valB);
                }
                if (typeof valA === 'string') {
                    return direction === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
                }
                return direction === 'asc' ? valA - valB : valB - valA;
            });
            return sorted;
        }

        // ===== RENDER (dengan pagination) =====
        function renderPage(items, page, append = false) {
            const start = (page - 1) * perPage;
            const end = start + perPage;
            const pageItems = items.slice(start, end);

            if (pageItems.length === 0 && !append) {
                grid.innerHTML = `<p class="empty-state">Tidak ada artwork.</p>`;
                if (loadBtn) loadBtn.style.display = 'none';
                if (showingSpan) showingSpan.textContent = '0';
                return;
            }

            const html = pageItems.map(item => `
                <div class="card" data-slug="${item.slug}">
                    <a href="/artwork/${item.slug}/" class="card-link-wrapper">
                        <div class="thumb" style="background-image: url('${item.image}'); background-size: cover; background-position: center;">
                            <div class="card-overlay">
                                <h3>${item.title}</h3>
                                <p>${item.year || ''}</p>
                                <span class="card-link">View Artwork →</span>
                            </div>
                        </div>
                    </a>
                </div>
            `).join('');

            if (append) {
                grid.insertAdjacentHTML('beforeend', html);
            } else {
                grid.innerHTML = html;
            }

            const totalItems = items.length;
            const loadedCount = Math.min(page * perPage, totalItems);
            const hasMore = loadedCount < totalItems;

            if (loadBtn) {
                if (hasMore) {
                    loadBtn.style.display = 'block';
                    loadBtn.dataset.nextPage = page + 1;
                    loadBtn.disabled = false;
                    loadBtn.textContent = 'Load More';
                } else {
                    loadBtn.style.display = 'none';
                }
            }

            if (showingSpan) showingSpan.textContent = loadedCount;

            // Tampilkan tombol View All jika belum semua dimuat
            if (viewAllBtn) {
                viewAllBtn.style.display = (loadedCount < totalItems) ? 'block' : 'none';
            }
        }

        // ===== RENDER ALL (tanpa pagination) =====
        function renderAll(items) {
            if (items.length === 0) {
                grid.innerHTML = `<p class="empty-state">Tidak ada artwork.</p>`;
                if (showingSpan) showingSpan.textContent = '0';
                return;
            }

            const html = items.map(item => `
                <div class="card" data-slug="${item.slug}">
                    <a href="/artwork/${item.slug}/" class="card-link-wrapper">
                        <div class="thumb" style="background-image: url('${item.image}'); background-size: cover; background-position: center;">
                            <div class="card-overlay">
                                <h3>${item.title}</h3>
                                <p>${item.year || ''}</p>
                                <span class="card-link">View Artwork →</span>
                            </div>
                        </div>
                    </a>
                </div>
            `).join('');

            grid.innerHTML = html;
            if (showingSpan) showingSpan.textContent = items.length;
            if (loadBtn) loadBtn.style.display = 'none';
            if (viewAllBtn) viewAllBtn.style.display = 'none';
        }

        // ===== VIEW ALL =====
        if (viewAllBtn) {
            viewAllBtn.addEventListener('click', function() {
                const sort = sortSelect ? sortSelect.value : 'created_at.desc';
                const allSorted = sortArtworks(allArtworks, sort);
                filteredData = allSorted;
                renderAll(allSorted);
            });
        }

        // ===== FILTER + SORT =====
        function applyFilters() {
            const sort = sortSelect ? sortSelect.value : 'created_at.desc';
            let filtered = sortArtworks(allArtworks, sort);
            filteredData = filtered;
            currentPage = 1;
            renderPage(filteredData, currentPage, false);
        }

        // ===== LOAD MORE =====
        function loadMore() {
            if (!filteredData.length) return;
            const nextPage = parseInt(loadBtn.dataset.nextPage) || 2;
            const totalPages = Math.ceil(filteredData.length / perPage);

            if (nextPage <= totalPages) {
                currentPage = nextPage;
                renderPage(filteredData, currentPage, true);
            } else {
                loadBtn.style.display = 'none';
            }
        }

        // ===== INISIALISASI =====
        // Cek apakah ini halaman yang kembali dari artwork (ada saved scroll)
        const savedScroll = sessionStorage.getItem('artist_scroll_position');
        const isReturning = savedScroll !== null;

        document.addEventListener('DOMContentLoaded', function() {
            filteredData = sortArtworks(allArtworks, 'created_at.desc');

            if (isReturning) {
                // Jika kembali dari artwork, langsung render semua
                renderAll(filteredData);
                // Restore scroll setelah render
                setTimeout(function() {
                    window.scrollTo({
                        top: parseInt(savedScroll, 10),
                        behavior: 'instant'
                    });
                    sessionStorage.removeItem('artist_scroll_position');
                }, 150);
            } else {
                // Normal: render 6 pertama
                renderPage(filteredData, 1, false);
            }
        });

        // ===== EVENT LISTENERS =====
        if (loadBtn) loadBtn.addEventListener('click', loadMore);
        if (sortSelect) sortSelect.addEventListener('change', applyFilters);

        window.applyFilters = applyFilters;
        window.loadMore = loadMore;

        // ===== SAVE SCROLL POSITION SAAT KLIK KARTU =====
        document.addEventListener('click', function(e) {
            const link = e.target.closest('.card a[href^="/artwork/"]');
            if (link) {
                sessionStorage.setItem('artist_scroll_position', window.scrollY);
            }
        });

    })();
</script>