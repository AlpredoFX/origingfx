            <!-- ===== RIGHT: Contact Form ===== -->
            <div class="contact-form">
                <h2>Mulai Percakapan</h2>

                <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
                    <input type="hidden" name="form-name" value="contact">

                    <!-- Honeypot -->
                    <div style="display: none;">
                        <label>Don't fill this out if you're human: <input name="bot-field"></label>
                    </div>

                    <div class="form-group">
                        <label for="name">Nama</label>
                        <input type="text" id="name" name="name" placeholder="Namamu..." required>
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="email@kamu.com" required>
                    </div>

                    <div class="form-group">
                        <label for="subject">Apa yang ingin kamu sampaikan?</label>
                        <select id="subject" name="subject" required>
                            <option value="">Pilih topik...</option>
                            <option value="Ingin mengajak OriginGFX bekerja sama">Ingin mengajak OriginGFX bekerja sama</option>
                            <option value="Ingin bergabung sebagai artist">Ingin bergabung sebagai artist</option>
                            <option value="Pertanyaan lainnya">Pertanyaan lainnya</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="message">Pesan</label>
                        <textarea id="message" name="message" placeholder="Ceritakan sedikit tentang ide atau kebutuhanmu..." rows="5" required></textarea>
                    </div>

                    <button type="submit" class="btn">
                        Kirim Pesan ✦
                    </button>

                    <p class="form-footer">Kami akan merespon secepat mungkin.</p>
                </form>
            </div>

