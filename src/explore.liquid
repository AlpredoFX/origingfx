---
layout: layout.liquid
title: Explore — OriginGFX
---

<section class="page-hero reveal">
    <div class="container center">
        <h1>Discover Artworks</h1>
        <p class="lead">Temukan karya terbaik dari para kreator Minecraft</p>
        <p class="hero-tagline" style="font-size: 0.9rem; color: var(--muted); letter-spacing: 0.08em; margin-top: 6px;">
            Gallery First. Store Second. Artist Always.
        </p>
    </div>
</section>

<section class="section reveal" style="padding-top: 20px;">
    <div class="container">

        <!-- ====== STATISTIK ====== -->
        <div class="explore-stats">
            <span class="stat-item">
                <span class="stat-number">{{ supabase.artworks | size }}</span>
                <span class="stat-label">Artworks</span>
            </span>
            <span class="stat-divider"></span>
            <span class="stat-item">
                <span class="stat-number">{{ supabase.artists | size }}</span>
                <span class="stat-label">Artists</span>
            </span>
            <span class="stat-divider"></span>
            <span class="stat-item">
                <span class="stat-number">{{ supabase.categories | size }}</span>
                <span class="stat-label">Categories</span>
            </span>
        </div>

        <!-- ====== FEATURED TODAY ====== -->
        {% assign featuredArtwork = supabase.featuredArtworks | first %}
        {% if featuredArtwork %}
        <div class="featured-today">
            <span class="featured-today-label">✦ Featured Today</span>
            <a href="/artwork/{{ featuredArtwork.slug }}" class="featured-today-link">
                <div class="featured-today-image" style="background-image: url('{{ featuredArtwork.image }}'); background-size: cover; background-position: center;"></div>
                <div class="featured-today-content">
                    <h3>{{ featuredArtwork.title }}</h3>
                    <p>by {{ featuredArtwork.artist }}</p>
                    <span class="featured-today-cta">View Artwork →</span>
                </div>
            </a>
        </div>
        {% endif %}

        <!-- ====== SEARCH & FILTER ====== -->
        <div class="search-filter-container">
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="🔍 Cari artwork..." oninput="applyFilters()">
            </div>
            <div class="filter-group">
                <select id="categoryFilter" onchange="applyFilters()">
                    <option value="">All Categories</option>
                    {% for cat in supabase.categories %}
                        <option value="{{ cat }}">{{ cat }}</option>
                    {% endfor %}
                </select>
                <select id="artistFilter" onchange="applyFilters()">
                    <option value="">All Artists</option>
                    {% for name in supabase.artistNames %}
                        <option value="{{ name }}">{{ name }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <!-- ====== GRID ====== -->
        <div id="artworkGrid" class="grid grid-4"></div>

        <!-- ====== LOAD MORE ====== -->
        <div class="load-more-wrapper">
            <button class="btn load-more-btn" id="loadMoreBtn">Load More</button>
        </div>
        <p class="explore-info" id="resultCount">Menampilkan 0 dari 0 artworks</p>

    </div>
</section>

<!-- ====== STYLE GUIDE MODAL ====== -->
<div id="styleGuideModal" class="style-guide-modal">
    <div class="style-guide-content">
        <h2>Minecraft Artwork Styles</h2>
        <p class="sub">Istilah yang digunakan komunitas render Minecraft Indonesia</p>

        <div class="style-guide-item">
            <h3>Manip</h3>
            <p>Photo manipulation dengan compositing dan efek sinematik. Fokus pada lighting, atmosfer, dan penggabungan elemen visual.</p>
        </div>
        <div class="style-guide-item">
            <h3>Art</h3>
            <p>Render 3D yang dipoles ulang dengan teknik digital painting hingga tampak seperti ilustrasi 2D atau semi-anime.</p>
        </div>
        <div class="style-guide-item">
            <h3>Scene</h3>
            <p>Menonjolkan lingkungan, storytelling, dan komposisi. Biasanya tidak berfokus pada karakter tunggal.</p>
        </div>
        <div class="style-guide-item">
            <h3>Abstract</h3>
            <p>Eksplorasi warna, shape, dan efek visual tanpa mengikuti komposisi realistis.</p>
        </div>

        <button class="modal-close" id="modalClose">Close</button>
    </div>
</div>

<!-- ====== SIGNATURE ====== -->
<section class="section reveal section-signature">
    <div class="signature-section">
         <div class="signature-quote">
            <span class="quote-mark">✦</span>
            <p>Discover the artists behind every masterpiece.</p>
        </div>
    </div>
</section>

<!-- ====== JAVASCRIPT ====== -->
<script>
    (function() {
        // Ambil semua data dari Eleventy
        const allArtworks = {{ supabase.artworks | json }};

        let currentPage = 1;
        const perPage = 8;
        let filteredData = []; // akan diisi saat filter

        // Fungsi untuk render kartu (append mode)
        function renderArtworks(items, append = false) {
            const grid = document.getElementById('artworkGrid');

            if (!items || items.length === 0) {
                if (!append) {
                    grid.innerHTML = `<p class="empty-state">Tidak ada artwork yang cocok dengan filter.</p>`;
                }
                document.getElementById('loadMoreBtn').style.display = 'none';
                document.getElementById('resultCount').textContent = `Menampilkan 0 dari ${filteredData.length} artworks`;
                return;
            }

            let html = items.map(item => `
                <div class="card" data-category="${item.category || ''}" data-artist="${item.artist || ''}">
                    <a href="/artwork/${item.slug}/" class="card-link-wrapper">
                        <div class="thumb" style="background-image: url('${item.image}'); background-size: cover; background-position: center;">
                            <div class="card-overlay">
                                <h3>${item.title}</h3>
                                <p>by ${item.artist}</p>
                                <span class="card-link">View Artwork →</span>
                            </div>
                        </div>
                    </a>
                </div>
            `).join('');

            if (append) {
                grid.insertAdjacentHTML('beforeend', html);
            } else {
                grid.innerHTML = html;
            }

            // Update tombol Load More
            const loadBtn = document.getElementById('loadMoreBtn');
            const totalDisplayed = currentPage * perPage;
            if (totalDisplayed >= filteredData.length) {
                loadBtn.style.display = 'none';
            } else {
                loadBtn.style.display = 'block';
            }

            document.getElementById('resultCount').textContent = 
                `Menampilkan ${Math.min(totalDisplayed, filteredData.length)} dari ${filteredData.length} artworks`;
        }

        function applyFilters() {
            const keyword = document.getElementById('searchInput').value.toLowerCase().trim();
            const category = document.getElementById('categoryFilter').value;
            const artist = document.getElementById('artistFilter').value;

            filteredData = allArtworks.filter(item => {
                const matchTitle = item.title.toLowerCase().includes(keyword);
                const matchCategory = category ? item.category === category : true;
                const matchArtist = artist ? item.artist === artist : true;
                return matchTitle && matchCategory && matchArtist;
            });

            // Reset ke halaman 1
            currentPage = 1;
            // Ambil item untuk halaman pertama
            const start = 0;
            const end = start + perPage;
            const pageItems = filteredData.slice(start, end);

            // Render ulang (replace)
            renderArtworks(pageItems, false);
        }

        // Load More: append halaman berikutnya
        function loadMore() {
            currentPage++;
            const start = (currentPage - 1) * perPage;
            const end = start + perPage;
            const pageItems = filteredData.slice(start, end);

            if (pageItems.length === 0) {
                document.getElementById('loadMoreBtn').style.display = 'none';
                return;
            }

            renderArtworks(pageItems, true);
        }

        // Inisialisasi
        document.addEventListener('DOMContentLoaded', function() {
            filteredData = allArtworks;
            const start = 0;
            const end = start + perPage;
            const initialItems = filteredData.slice(start, end);
            renderArtworks(initialItems, false);
        });

        // Event listener untuk tombol Load More
        document.getElementById('loadMoreBtn').addEventListener('click', loadMore);

        // Ekspos fungsi ke global agar bisa dipanggil dari HTML (oninput, onchange)
        window.applyFilters = applyFilters;

        // Style Guide Modal
        const modal = document.getElementById('styleGuideModal');
        const styleBtn = document.getElementById('styleGuideBtn');
        if (styleBtn) {
            styleBtn.addEventListener('click', function() {
                modal.style.display = 'flex';
            });
        }
        document.getElementById('modalClose').addEventListener('click', function() {
            modal.style.display = 'none';
        });
        window.addEventListener('click', function(e) {
            if (e.target === modal) {
                modal.style.display = 'none';
            }
        });
    })();
</script>