---
layout: layout.liquid
title: "{{ artwork.title }} — OriginGFX"
pagination:
  data: supabase.artworks
  size: 1
  alias: artwork
permalink: "/artwork/{{ artwork.slug }}/"
---

<section class="section reveal" style="padding-top: 40px;">
    <div class="container">

        <!-- ====== BACK LINK ====== -->
        <a href="#" class="back-link" onclick="history.back(); return false;">← Back</a>

        <!-- ====== ARTWORK DETAIL ====== -->
        <div class="artwork-detail">

            <!-- KIRI: Gambar -->
            <div class="artwork-image">
                <div class="artwork-placeholder" data-image="{{ artwork.image | escape }}" data-title="{{ artwork.title | escape }}">
                    <img src="{{ artwork.image }}" alt="{{ artwork.title }}" loading="lazy">
                    <div class="zoom-hint">🔍 Klik untuk memperbesar</div>
                </div>
            </div>

            <!-- KANAN: Info -->
            <div class="artwork-info">
                <span class="artwork-tag">{{ artwork.category }}</span>
                <h1>{{ artwork.title }}</h1>

                <!-- ====== ARTIST CARD (mini) ====== -->
                {% assign artist = supabase.artists | where: "id", artwork.artist_id | first %}
                <div class="artwork-artist-card">
                    <div class="mini-avatar" style="background-image: url('{{ artist.avatar }}'); background-size: cover; background-position: center;"></div>
                    <div class="mini-artist-info">
                        <a href="/artist/{{ artist.slug }}" class="mini-artist-name">{{ artist.name }}</a>
                        <span class="mini-artist-role">{{ supabase.artistDynamicRole[artist.id] | default: artist.role }}</span>
                        <span class="mini-artist-stats">
                            {% assign artistArtworks = supabase.artworks | where: "artist_id", artist.id | size %}
                            {{ artistArtworks }} Artworks
                        </span>
                    </div>
                    <a href="/artist/{{ artist.slug }}" class="mini-artist-link">View Profile →</a>
                </div>

                <!-- ====== DESKRIPSI ====== -->
                <div class="artwork-description">
                    {% assign desc = artwork.description %}
                    {% if desc contains "currently part of my personal archive" or desc contains "title and detailed story will be added" %}
                        <p class="artwork-description-placeholder">From the artist's personal archive. More details will be added as the collection develops.</p>
                    {% else %}
                        <p>{{ desc }}</p>
                    {% endif %}
                </div>

                <!-- ====== ARTWORK INFORMATION (detail) ====== -->
                <div class="artwork-info-detail">
                    <span class="info-title">Artwork Information</span>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">Artist</span>
                            <span class="info-value">
                                <a href="/artist/{{ artist.slug }}" class="info-artist-link">{{ artist.name }}</a>
                            </span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Year</span>
                            <span class="info-value">{{ artwork.year | default: '-' }}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Category</span>
                            <span class="info-value">{{ artwork.category | default: '-' }}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Software</span>
                            <span class="info-value">
                                {% assign softwareList = artwork.software %}
                                {% if softwareList %}
                                    {% if softwareList.first %}
                                        {{ softwareList | join: ', ' }}
                                    {% elsif softwareList != '' %}
                                        {{ softwareList }}
                                    {% else %}
                                        -
                                    {% endif %}
                                {% else %}
                                    -
                                {% endif %}
                            </span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Views</span>
                            <span class="info-value" id="info-view-count">
                                <span id="info-view-number">{{ artwork.views | default: 0 }}</span>
                                <span id="info-view-label">{% if artwork.views == 1 %}view{% else %}views{% endif %}</span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ====== ARTIST'S NOTE ====== -->
                {% if artwork.artist_note %}
                <div class="artist-note">
                    <span class="note-label">✦ Artist's Note</span>
                    <p>{{ artwork.artist_note }}</p>
                </div>
                {% endif %}

                <!-- ====== COMMISSION & ACTION ====== -->
                <div class="artwork-actions">
                    <div class="action-primary">
                        <span class="action-hint">Interested in a similar style?</span>
                        {% assign commissionLink = false %}
                        {% if artist.social.instagram %}
                            {% assign commissionLink = artist.social.instagram %}
                            {% assign commissionLabel = 'Commission via Instagram' %}
                        {% elsif artist.social.discord %}
                            {% assign commissionLink = artist.social.discord %}
                            {% assign commissionLabel = 'Commission via Discord' %}
                        {% elsif artist.social.fiverr %}
                            {% assign commissionLink = artist.social.fiverr %}
                            {% assign commissionLabel = 'Commission via Fiverr' %}
                        {% else %}
                            {% assign commissionLink = '/artist/' | append: artist.slug %}
                            {% assign commissionLabel = 'Commission Artist →' %}
                        {% endif %}
                        <a href="{{ commissionLink }}" target="_blank" class="btn btn-commission">{{ commissionLabel }}</a>
                    </div>
                    <div class="action-secondary">
                        <a href="/artist/{{ artist.slug }}" class="btn-outline">Visit Artist Profile</a>
                        <button class="btn-text" id="save-artwork">♡ Save Artwork</button>
                    </div>
                </div>

                <!-- ====== SHARE ====== -->
                <div class="artwork-share">
                    <span class="share-label">Share this Artwork</span>
                    <div class="share-links">
                        <a href="https://twitter.com/intent/tweet?url={{ page.url | url_encode }}&text={{ artwork.title }} by {{ artist.name }}" target="_blank" class="share-btn twitter">Twitter</a>
                        <a href="https://www.pinterest.com/pin/create/button/?url={{ page.url | url_encode }}&media={{ artwork.image }}&description={{ artwork.title }}" target="_blank" class="share-btn pinterest">Pinterest</a>
                        <a href="#" class="share-btn copy-link" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied!'); return false;">Copy Link</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ====== CONTINUE EXPLORING (More from this Artist) ====== -->
        <div class="more-from-artist">
            <div class="more-from-header">
                <h3>Continue Exploring</h3>
                <a href="/artist/{{ artist.slug }}" class="section-more">View all →</a>
            </div>
            <div class="grid grid-3">
                {% assign artistArtworks = supabase.artworks | where: "artist_id", artist.id %}
                {% assign moreArtworks = "" | split: "" %}
                {% for a in artistArtworks %}
                    {% if a.slug != artwork.slug %}
                        {% assign moreArtworks = moreArtworks | push: a %}
                    {% endif %}
                {% endfor %}
                {% assign limitedArtworks = moreArtworks | slice: 0, 6 %}
                {% for a in limitedArtworks %}
                <div class="card">
                    <div class="thumb" style="background-image: url('{{ a.image }}'); background-size: cover; background-position: center;"></div>
                    <h3>{{ a.title }}</h3>
                    <p>{{ a.year }}</p>
                    <a href="/artwork/{{ a.slug }}" class="card-link">View Artwork →</a>
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- ====== RELATED ARTWORKS (based on category) ====== -->
        <div class="related-artworks">
            <h3>You Might Also Like</h3>
            <div class="grid grid-3">
                {% assign sameCategory = supabase.artworks | where: "category", artwork.category | reject: "id", artwork.id %}
                {% assign others = supabase.artworks | reject: "id", artwork.id | reject: "artist_id", artist.id %}
                {% assign combined = sameCategory | concat: others %}
                {% assign unique = "" | split: "" %}
                {% for item in combined %}
                    {% unless unique contains item.id %}
                        {% assign unique = unique | push: item %}
                    {% endunless %}
                {% endfor %}
                {% assign related = unique | slice: 0, 3 %}
                {% for item in related %}
                <div class="card">
                    <div class="thumb" style="background-image: url('{{ item.image }}'); background-size: cover; background-position: center;"></div>
                    <h3>{{ item.title }}</h3>
                    <p>by {{ item.artist }}</p>
                    <a href="/artwork/{{ item.slug }}" class="card-link">View Artwork →</a>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>
</section>

<!-- ====== LIGHTBOX ====== -->
<div id="lightbox" class="lightbox">
    <div class="lightbox-content" onclick="event.stopPropagation()">
        <button class="lightbox-close" onclick="closeLightbox()">✕</button>
        <div class="lightbox-image-container" id="lightbox-container">
            <img id="lightbox-img" src="" alt="">
            <div class="zoom-hint">🔍 Klik untuk memperbesar</div>
            <div class="lightbox-controls">
                <button class="zoom-btn" onclick="zoomIn()">＋</button>
                <button class="zoom-btn" onclick="zoomOut()">−</button>
                <button class="zoom-btn" onclick="resetZoom()">⟲</button>
            </div>
        </div>
        <p id="lightbox-caption" class="lightbox-caption"></p>
        <p class="lightbox-hint">Scroll untuk zoom · Drag untuk geser</p>
    </div>
</div>

<!-- ====== JAVASCRIPT: LIGHTBOX ====== -->
<script>
    (function() {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');
        const placeholder = document.querySelector('.artwork-placeholder');

        // ===== ZOOM STATE =====
        let currentScale = 1;
        const container = document.getElementById('lightbox-container');

        // ===== FUNGSI ZOOM =====
        window.zoomIn = function() {
            currentScale = Math.min(currentScale + 0.25, 4);
            applyZoom();
        };
        window.zoomOut = function() {
            currentScale = Math.max(currentScale - 0.25, 0.5);
            applyZoom();
        };
        window.resetZoom = function() {
            currentScale = 1;
            applyZoom();
            if (container) {
                container.scrollLeft = 0;
                container.scrollTop = 0;
            }
        };

        function applyZoom() {
            if (lightboxImg) {
                lightboxImg.style.transform = `scale(${currentScale})`;
                lightboxImg.style.transformOrigin = 'center center';
            }
        }

        // ===== BUKA LIGHTBOX =====
        window.openLightbox = function(imageUrl, title) {
            if (!lightbox || !lightboxImg) return;
            lightboxImg.src = imageUrl;
            if (lightboxCaption) lightboxCaption.textContent = title || 'Artwork';
            lightbox.style.display = 'flex';
            document.body.style.overflow = 'hidden';
            currentScale = 1;
            applyZoom();
            if (container) {
                container.scrollLeft = 0;
                container.scrollTop = 0;
            }
        };

        // ===== TUTUP LIGHTBOX =====
        window.closeLightbox = function() {
            if (!lightbox) return;
            lightbox.style.display = 'none';
            document.body.style.overflow = '';
            currentScale = 1;
            applyZoom();
        };

        // ===== KLIK PADA GAMBAR =====
        if (placeholder) {
            placeholder.addEventListener('click', function() {
                const imageUrl = this.dataset.image;
                const title = this.dataset.title || 'Artwork';
                if (imageUrl) {
                    openLightbox(imageUrl, title);
                }
            });
        }

        // ===== TUTUP DENGAN KLIK DI LUAR =====
        if (lightbox) {
            lightbox.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeLightbox();
                }
            });
        }

        // ===== TUTUP DENGAN ESC =====
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });

        // ===== TOMBOL CLOSE =====
        const closeBtn = document.querySelector('.lightbox-close');
        if (closeBtn) {
            closeBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                closeLightbox();
            });
        }
    })();
</script>

<!-- ====== SIGNATURE ====== -->
<section class="section reveal section-signature">
    <div class="signature-section">
         <div class="signature-quote">
            <span class="quote-mark">✦</span>
            <p>Every artwork deserves to be discovered.</p>
        </div>
    </div>
</section>