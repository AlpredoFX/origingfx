---
layout: layout.liquid
title: OriginGFX — Digital Gallery for Minecraft Artists
---

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="hero reveal">
    <div class="container center">
        <!-- Hero Grid -->
        <div class="hero-grid">
            {% assign heroArtworks = supabase.latestArtworks | slice: 0, 4 %}
            {% for artwork in heroArtworks %}
            <div class="hero-thumb" style="background-image: url('{{ artwork.image }}'); background-size: cover; background-position: center;"></div>
            {% endfor %}
        </div>

        <!-- Hero Text -->
        <h1>Digital Gallery for <br>Minecraft Artists</h1>
        <p class="lead">Gallery First. Store Second. Artist Always.</p>
        <p class="hero-sub">Menampilkan karya terbaik dari para kreator Minecraft</p>

        <!-- Stats -->
        <div class="hero-stats">
            <div class="hero-stat">
                <span class="hero-stat-number">{{ supabase.artists | size }}</span>
                <span class="hero-stat-label">Artists</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-number">{{ supabase.artworks | size }}</span>
                <span class="hero-stat-label">Artworks</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-number">✦</span>
                <span class="hero-stat-label">Curated</span>
            </div>
        </div>

        <a class="btn" href="/explore">Explore Gallery</a>

        <!-- ===== HERO "NYAWA" — Featured Today Mini ===== -->
        <div class="hero-extra">
            {% assign featuredArtwork = supabase.featuredArtworks | first %}
            {% if featuredArtwork %}
            <span class="hero-extra-label">✦ Featured Today</span>
            <a href="/artwork/{{ featuredArtwork.slug }}" class="hero-extra-link">
                <span class="hero-extra-title">{{ featuredArtwork.title }}</span>
                <span class="hero-extra-artist">by {{ featuredArtwork.artist }}</span>
            </a>
            {% else %}
            <span class="hero-extra-label">✦ Latest Artist</span>
            {% assign latestArtist = supabase.artists | sort: "created_at" | reverse | first %}
            {% if latestArtist %}
            <a href="/artist/{{ latestArtist.slug }}" class="hero-extra-link">
                <span class="hero-extra-title">{{ latestArtist.name }}</span>
                <span class="hero-extra-artist">joined OriginGFX</span>
            </a>
            {% endif %}
            {% endif %}
        </div>
    </div>
</section>

<!-- ============================================================
     FEATURED SHOWCASE
     ============================================================ -->
<section id="featured" class="section reveal">
    <div class="container">
        <div class="section-head">
            <span>01</span>
            <h2>Featured Showcase</h2>
        </div>
        <p class="section-subtitle">Pilihan karya yang paling merepresentasikan kualitas dan kreativitas komunitas OriginGFX.</p>

        {% assign featuredArtwork = supabase.featuredArtworks | first %}
        {% if featuredArtwork %}
            <a href="/artwork/{{ featuredArtwork.slug }}" class="featured-wrapper">
                <div class="featured-image" style="background-image: url('{{ featuredArtwork.image }}'); background-size: cover; background-position: center;">
                    <div class="featured-overlay">
                        <div class="featured-content">
                            <div class="featured-badge-wrapper">
                                <span class="featured-badge-line"></span>
                                <span class="featured-badge">✦ Editor's Pick</span>
                                <span class="featured-badge-line"></span>
                            </div>
                            <h3>{{ featuredArtwork.title }}</h3>
                            <p>by {{ featuredArtwork.artist }}</p>

                            <!-- Metadata tambahan -->
                            <div class="featured-meta">
                                {% if featuredArtwork.category %}
                                <span class="featured-tag">{{ featuredArtwork.category }}</span>
                                {% endif %}
                                {% if featuredArtwork.year %}
                                <span class="featured-year">{{ featuredArtwork.year }}</span>
                                {% endif %}
                            </div>

                            <span class="featured-link">View Artwork →</span>
                        </div>
                    </div>
                </div>
            </a>
        {% else %}
            <p class="featured-error">Belum ada artwork yang dipilih sebagai featured.</p>
        {% endif %}
    </div>
</section>

<!-- ============================================================
     LATEST UPLOADS
     ============================================================ -->
<section class="section reveal">
    <div class="container">
        <div class="section-head">
            <span>02</span>
            <h2>Latest Uploads</h2>
            <a href="/explore" class="section-more">View all →</a>
        </div>
        <p class="section-subtitle">Karya terbaru dari para artist di galeri.</p>

        <div class="grid">
            {% assign latestItems = supabase.latestArtworks | slice: 0, 3 %}
            {% if latestItems.size == 0 %}
                {% assign latestItems = supabase.artworks | sort: "created_at" | reverse | slice: 0, 3 %}
            {% endif %}
            {% for item in latestItems %}
            <div class="card">
                <div class="thumb" style="background-image: url('{{ item.image }}'); background-size: cover; background-position: center;">
                    <!-- Badge "New" jika dibuat dalam 7 hari terakhir -->
                    {% assign itemDate = item.created_at | date: "%s" | plus: 0 %}
                    {% assign nowDate = "now" | date: "%s" | plus: 0 %}
                    {% assign diff = nowDate | minus: itemDate %}
                    {% if diff < 604800 %}
                    <span class="badge-new">New</span>
                    {% endif %}
                </div>
                <h3>{{ item.title }}</h3>
                <p>by {{ item.artist }}</p>
                <!-- Metadata tambahan -->
                <div class="card-meta">
                    {% if item.category %}
                    <span class="card-category">{{ item.category }}</span>
                    {% endif %}
                    {% if item.created_at %}
                    <span class="card-date">{{ item.created_at | date: "%d %b %Y" }}</span>
                    {% endif %}
                </div>
                <a href="/artwork/{{ item.slug }}" class="card-link">View Artwork →</a>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- ============================================================
     TRENDING NOW
     ============================================================ -->
<section class="section reveal" style="padding-top: 20px;">
    <div class="container">
        <div class="section-head">
             <span>03</span>
            <h2>Trending Now</h2>
            <a href="/explore" class="section-more">View all →</a>
        </div>
        <p class="section-subtitle">Artwork yang sedang paling banyak menarik perhatian.</p>

        <div class="grid">
            {% assign trendingItems = supabase.trendingArtworks | slice: 0, 3 %}
            {% if trendingItems.size == 0 %}
                {% assign trendingItems = supabase.artworks | sort: "updated_at" | reverse | slice: 0, 3 %}
            {% endif %}
            {% for item in trendingItems %}
            <div class="card">
                <div class="thumb" style="background-image: url('{{ item.image }}'); background-size: cover; background-position: center;">
                    <div class="trending-badge-wrapper">
                        <span class="trending-badge">🔥 Trending</span>
                    </div>
                </div>
                <h3>{{ item.title }}</h3>
                <p>by {{ item.artist }}</p>
                <div class="card-meta">
                    {% if item.category %}
                    <span class="card-category">{{ item.category }}</span>
                    {% endif %}
                    <span class="trending-label">Popular this week</span>
                </div>
                <a href="/artwork/{{ item.slug }}" class="card-link">View Artwork →</a>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- ============================================================
     FEATURED ARTIST — Editorial Spotlight
     ============================================================ -->
{% assign featuredArtist = supabase.featuredArtists | first %}
{% if featuredArtist %}
<section class="section reveal" style="padding-top: 20px; padding-bottom: 10px;">
    <div class="container">
        <div class="featured-artist-editorial">
            <div class="featured-artist-editorial-header">
                <span class="featured-artist-editorial-label">✦ Artist Spotlight</span>
                <span class="featured-artist-editorial-sub">A curated highlight from the gallery</span>
            </div>
            <div class="featured-artist-editorial-card">
                <div class="featured-artist-editorial-avatar" style="background-image: url('{{ featuredArtist.avatar }}'); background-size: cover; background-position: center;"></div>
                <div class="featured-artist-editorial-info">
                    <h3>{{ featuredArtist.name }}</h3>
                    <p class="featured-artist-editorial-role">{{ featuredArtist.role }}</p>
                    <div class="featured-artist-editorial-stats">
                        {% assign artistArtworks = supabase.artworks | where: "artist_id", featuredArtist.id | size %}
                        <span><strong>{{ artistArtworks }}</strong> Artworks</span>
                        <span class="meta-dot">·</span>
                        <span>Joined {{ featuredArtist.joined | default: '2026' }}</span>
                    </div>
                    <p class="featured-artist-editorial-bio">{{ featuredArtist.bio | truncate: 130 }}</p>
                    <a href="/artist/{{ featuredArtist.slug }}" class="btn btn-primary">View Profile →</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}

<!-- ============================================================
     MEET OUR ARTISTS — Preview Komunitas (4 artist)
     ============================================================ -->
<section class="section reveal visible section-short">
    <div class="container">
        <div class="section-head">
            <span>04</span>
            <h2>Meet Our Artists</h2>
            <a href="/artists" class="section-more">View all →</a>
        </div>
        <p class="section-subtitle">Talenta di balik setiap karya yang kamu lihat.</p>

        <div class="artists-grid-home">
            {% assign featuredArtist = supabase.featuredArtists | first %}
            {% assign featuredArtistId = featuredArtist.id | default: '' %}

            {% comment %}
                Ambil 4 artist dengan prioritas:
                1. Jangan ambil featured artist (jika ada)
                2. Prioritaskan non-founder
                3. Jika kurang, tambahkan founder
            {% endcomment %}
            {% assign nonFounder = supabase.artists | where_exp: "artist", "artist.badge != 'founder'" %}
            {% assign excludeId = featuredArtistId %}
            {% assign candidateArtists = "" | split: "" %}

            {% comment %} Ambil non-founder yang bukan featured {% endcomment %}
            {% for artist in nonFounder %}
                {% if artist.id != excludeId %}
                    {% assign candidateArtists = candidateArtists | push: artist %}
                {% endif %}
            {% endfor %}

            {% assign targetCount = 4 %}
            {% assign resultArtists = "" | split: "" %}

            {% comment %} Ambil dari candidate (non-founder) sampai 4 atau habis {% endcomment %}
            {% for artist in candidateArtists limit: targetCount %}
                {% assign resultArtists = resultArtists | push: artist %}
            {% endfor %}

            {% comment %} Jika masih kurang, ambil founder (kecuali founder = featured) {% endcomment %}
            {% if resultArtists.size < targetCount %}
                {% assign founder = supabase.artists | where: "badge", "founder" | first %}
                {% if founder and founder.id != excludeId %}
                    {% assign resultArtists = resultArtists | push: founder %}
                {% endif %}
            {% endif %}

            {% comment %} Jika masih kurang, ambil siapapun (termasuk featured) untuk memenuhi 4 {% endcomment %}
            {% if resultArtists.size < targetCount %}
                {% assign remaining = targetCount | minus: resultArtists.size %}
                {% assign fallback = supabase.artists | where_exp: "artist", "artist.id != resultArtists[0].id and artist.id != resultArtists[1].id and artist.id != resultArtists[2].id" | slice: 0, remaining %}
                {% for artist in fallback %}
                    {% assign resultArtists = resultArtists | push: artist %}
                {% endfor %}
            {% endif %}

            {% for artist in resultArtists limit: 4 %}
                {% assign artistArtworks = supabase.artworks | where: "artist_id", artist.id | size %}
                <a href="/artist/{{ artist.slug }}" class="artist-card-home">
                    <div class="artist-avatar-home" style="background-image: url('{{ artist.avatar }}'); background-size: cover; background-position: center;"></div>
                    <div class="artist-info-home">
                        <h4>{{ artist.name }}</h4>
                        <span class="artist-role-home">{{ artist.role }}</span>
                        <span class="artist-count-home">{{ artistArtworks }} Artworks</span>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

<!-- ============================================================
     WHAT IS ORIGINGFX? — cerita & jiwa
     ============================================================ -->
<section class="section reveal" style="padding-top: 40px;">
    <div class="container">
        <div class="origin-story">
            <div class="origin-story-content">
                <span class="origin-label">✦ Gallery First</span>
                <h2>What is OriginGFX?</h2>
                <p>
                    OriginGFX adalah galeri digital yang dibuat untuk memperkenalkan 
                    <strong>Minecraft artist</strong> dan karya mereka. 
                    Kami percaya setiap artwork memiliki cerita, dan setiap artist 
                    pantas memiliki ruang untuk dikenal.
                </p>
                <p style="margin-top: 12px; opacity: 0.7;">
                    <em>Gallery First. Store Second. Artist Always.</em>
                </p>
                <a href="/about" class="btn btn-outline" style="margin-top: 16px;">About OriginGFX →</a>
            </div>
            <div class="origin-story-visual">
                <div class="origin-quote-block">
                    <span class="quote-icon">✦</span>
                    <blockquote>
                        "Behind every artwork is a story worth knowing."
                    </blockquote>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     SIGNATURE
     ============================================================ -->
<section class="section reveal section-signature">
    <div class="signature-section">
        <div class="signature-quote">
            <span class="quote-mark">✦</span>
            <p>Every artwork deserves to be discovered.</p>
        </div>
    </div>
</section>