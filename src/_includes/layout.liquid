<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="artwork-slug" content="{{ artwork.slug }}">

    <!-- ===== TITLE DINAMIS (SEO) ===== -->
    <title>
        {%- if artwork %}
            {{ artwork.title }} — OriginGFX
        {%- elsif artist %}
            {{ artist.name }} | Minecraft Artist — OriginGFX
        {%- elsif title %}
            {{ title }}
        {%- else %}
            OriginGFX — Digital Gallery for Minecraft Artists
        {%- endif %}
    </title>

    <!-- ===== META DESCRIPTION DINAMIS ===== -->
    <meta name="description" content="
        {%- if artwork %}
            {{ artwork.description | strip_html | truncate: 160 }} — OriginGFX
        {%- elsif artist %}
            Explore {{ artist.name }}'s Minecraft artwork, portfolio, and creative work on OriginGFX.
        {%- elsif page.url == '/' %}
            OriginGFX is a digital gallery and community for Minecraft artists, showcasing cinematic renders, thumbnails, wallpapers, and more.
        {%- else %}
            OriginGFX — Gallery First. Store Second. Artist Always.
        {%- endif %}
    ">

    <!-- ===== CANONICAL ===== -->
    <link rel="canonical" href="https://origingfx.netlify.app{{ page.url }}">

    <!-- ===== CSS ===== -->
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/animations.css">
    <link rel="stylesheet" href="/assets/css/responsive.css">

    <!-- ===== FONTS ===== -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">

    <!-- ===== FAVICON ===== -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='12' fill='%23141414'/><text x='32' y='48' text-anchor='middle' font-size='40' fill='%23F4F4F2'>✦</text></svg>">

    <!-- ===== OPEN GRAPH ===== -->
    {% if artwork %}
        <meta property="og:type" content="article">
        <meta property="og:title" content="{{ artwork.title }} — OriginGFX">
        <meta property="og:description" content="{{ artwork.description | strip_html | truncate: 160 | default: 'Gallery First. Store Second. Artist Always.' }}">
        <meta property="og:image" content="https://origingfx.netlify.app/.netlify/functions/og-image?type=artwork&id={{ artwork.id }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:type" content="image/png">
        <meta property="og:url" content="https://origingfx.netlify.app/artwork/{{ artwork.slug }}">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ artwork.title }} — OriginGFX">
        <meta name="twitter:description" content="{{ artwork.description | strip_html | truncate: 160 | default: 'Gallery First. Store Second. Artist Always.' }}">
        <meta name="twitter:image" content="https://origingfx.netlify.app/.netlify/functions/og-image?type=artwork&id={{ artwork.id }}">

    {% elsif artist %}
        <meta property="og:type" content="profile">
        <meta property="og:title" content="{{ artist.name }} — OriginGFX">
        <meta property="og:description" content="{{ artist.role }} · {{ artist.bio | strip_html | truncate: 160 | default: 'Gallery First. Store Second. Artist Always.' }}">
        <meta property="og:image" content="https://origingfx.netlify.app/.netlify/functions/og-image?type=artist&slug={{ artist.slug }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:type" content="image/png">
        <meta property="og:url" content="https://origingfx.netlify.app/artist/{{ artist.slug }}">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ artist.name }} — OriginGFX">
        <meta name="twitter:description" content="{{ artist.role }} · {{ artist.bio | strip_html | truncate: 160 | default: 'Gallery First. Store Second. Artist Always.' }}">
        <meta name="twitter:image" content="https://origingfx.netlify.app/.netlify/functions/og-image?type=artist&slug={{ artist.slug }}">

    {% else %}
        <meta property="og:type" content="website">
        <meta property="og:title" content="OriginGFX — Digital Gallery for Minecraft Artists">
        <meta property="og:description" content="OriginGFX is a digital gallery and community for Minecraft artists, showcasing cinematic renders, thumbnails, wallpapers, and more.">
        <meta property="og:image" content="https://origingfx.netlify.app/.netlify/functions/og-image?type=home">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:type" content="image/png">
        <meta property="og:url" content="https://origingfx.netlify.app/">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="OriginGFX — Digital Gallery for Minecraft Artists">
        <meta name="twitter:description" content="OriginGFX is a digital gallery and community for Minecraft artists.">
        <meta name="twitter:image" content="https://origingfx.netlify.app/.netlify/functions/og-image?type=home">
    {% endif %}

    <!-- ===== JSON-LD Organization Schema (Hanya di Homepage) ===== -->
    {% if page.url == '/' %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "OriginGFX",
        "url": "https://origingfx.netlify.app",
        "logo": "https://origingfx.netlify.app/assets/images/favicon.svg",
        "description": "OriginGFX is a digital gallery and community for Minecraft artists, showcasing cinematic renders, thumbnails, wallpapers, and more.",
        "sameAs": [
            "https://instagram.com/alpredofx",
            "https://twitter.com/alpredof",
            "https://github.com/AlpredoFX/origingfx"
        ]
    }
    </script>
    {% endif %}

</head>
<body>

    {% include "header.liquid" %}

    <main>
        {{ content }}
    </main>

    {% include "footer.liquid" %}

    <!-- ===== SUPABASE CLIENT ===== -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        if (typeof window.supabase === 'undefined') {
            window.supabase = supabase.createClient(
                '{{ process.env.SUPABASE_URL }}',
                '{{ process.env.SUPABASE_ANON_KEY }}'
            );
        }
    </script>

    <!-- ===== APP & FILTER JS ===== -->
    <script src="/assets/js/app.js" defer></script>
    <script src="/assets/js/filter.js" defer></script>

</body>
</html>