<header class="header">
    <div class="container nav">
        <!-- Logo -->
        <a href="/" class="logo">
            <span class="logo-text">OriginGFX</span>
        </a>

        <!-- Navigasi + Toggle -->
        <div class="nav-right">
            <nav id="main-nav">
                <a href="/explore" class="nav-link">Explore</a>
                <a href="/artists" class="nav-link">Artists</a>
                <a href="/about" class="nav-link">About</a>
                <a href="/contact" class="nav-link">Contact</a>
            </nav>

            <!-- Toggle Theme -->
            <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
                <svg class="theme-icon" id="theme-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <!-- Icon akan diisi JavaScript -->
                </svg>
            </button>
        </div>

        <!-- Hamburger -->
        <button class="hamburger" id="hamburger" aria-label="Toggle menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>

<!-- ===== SCRIPT LANGSUNG DI HEADER (PASTI JALAN) ===== -->
<script>
    (function() {
        // Tunggu hingga DOM siap
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

        function init() {
            console.log('🔧 Header script initialized');

            // ===== THEME TOGGLE =====
            const toggle = document.getElementById('theme-toggle');
            const icon = document.getElementById('theme-icon');
            const html = document.documentElement;

            if (toggle && icon) {
                console.log('✅ Theme toggle found');

                function setTheme(theme) {
                    const isDark = theme === 'dark';
                    html.classList.add('manual-theme');
                    html.classList.toggle('dark-mode', isDark);
                    html.classList.toggle('light-mode', !isDark);
                    if (isDark) {
                        icon.innerHTML = `<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>`;
                    } else {
                        icon.innerHTML = `<circle cx="12" cy="12" r="5"/><path d="M12 1v2"/><path d="M12 21v2"/><path d="M4.22 4.22l1.42 1.42"/><path d="M18.36 18.36l1.42 1.42"/><path d="M1 12h2"/><path d="M21 12h2"/><path d="M4.22 19.78l1.42-1.42"/><path d="M18.36 5.64l1.42-1.42"/>`;
                    }
                    localStorage.setItem('theme', theme);
                }

                // Load saved theme
                const saved = localStorage.getItem('theme');
                if (saved) {
                    setTheme(saved);
                } else {
                    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    setTheme(prefersDark ? 'dark' : 'light');
                }

                // Event listener
                toggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    const isDark = html.classList.contains('dark-mode');
                    setTheme(isDark ? 'light' : 'dark');
                    console.log('🔄 Theme toggled to:', isDark ? 'light' : 'dark');
                });

                // Also try onclick as fallback
                toggle.onclick = function(e) {
                    e.preventDefault();
                    const isDark = html.classList.contains('dark-mode');
                    setTheme(isDark ? 'light' : 'dark');
                };

            } else {
                console.warn('❌ Theme toggle or icon not found!');
            }

            // ===== HAMBURGER =====
            const hamburger = document.getElementById('hamburger');
            const nav = document.getElementById('main-nav');

            if (hamburger && nav) {
                console.log('✅ Hamburger found');
                hamburger.addEventListener('click', function(e) {
                    e.preventDefault();
                    this.classList.toggle('open');
                    nav.classList.toggle('open');
                });
                // Fallback
                hamburger.onclick = function(e) {
                    e.preventDefault();
                    this.classList.toggle('open');
                    nav.classList.toggle('open');
                };
            } else {
                console.warn('❌ Hamburger or nav not found!');
            }
        }
    })();
</script>